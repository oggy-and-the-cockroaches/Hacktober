# Shipcheck + Verified Remediation Engine Configuration
SHIPCHECK_LLM_PROVIDER=gemma

# Gemma Model Configuration
GEMMA_MODEL=gemma-4-31b-it

# Gemini API Key for Gemma inference (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Gemma Endpoint (Optional for local Ollama / vLLM inference)
GEMMA_ENDPOINT=

# Database & Workspace Storage
SHIPCHECK_DB_PATH=shipcheck.db
SHIPCHECK_PROJECTS_DIR=./projects

# Server Configuration
HOST=0.0.0.0
PORT=8000
